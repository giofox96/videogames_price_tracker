# Copia questo file in .env e compila i valori.
PORT=8080
# Ogni quanti minuti cercare nuove offerte
SCAN_MINUTES=60
# Password per aprire l'app (consigliata se è online)
APP_PASSWORD=
# CAP per stimare la spedizione su eBay
ZIP=20100

# eBay Developer Program (gratuito): https://developer.ebay.com -> Application Keys (Production)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Opzionale: prezzi di riferimento per l'usato (API a pagamento) https://www.pricecharting.com/api-documentation
PRICECHARTING_TOKEN=

# Opzionale: avvisi sul telefono via Telegram (crea un bot con @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
